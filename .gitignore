# ============================================================
# Environment Variables (CRITICAL - NEVER COMMIT)
# ============================================================
.env
.env.local
.env.*.local
.env.production
.env.development
*.env

# ============================================================
# Sensitive Files & Directories
# ============================================================
# Archive folder may contain deployment guides with secrets
archive/
archive/*

# Scripts that may contain hardcoded credentials
scripts/*.ps1
scripts/*.mjs
scripts/run-schema.mjs
scripts/apply-schema.ps1

# ...but these two are part of the build/toolchain and contain no credentials.
# scripts/gen-route-htmls.mjs is REQUIRED: `npm run build` runs it, so if it is
# not committed a fresh clone (Vercel, CI, another machine) fails to build.
!scripts/gen-route-htmls.mjs
!scripts/gen-seo-images.mjs

# User data exports
*.csv
users_export_*.csv

# ============================================================
# Logs (may contain sensitive data)
# ============================================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ============================================================
# Dependencies
# ============================================================
node_modules
dist
dist-ssr
*.local

# ============================================================
# Editor directories and files
# ============================================================
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================================
# Deployment
# ============================================================
.vercel

# ============================================================
# Security Reports (Keep locally, don't commit)
